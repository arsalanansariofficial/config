{
  "json.schemaDownload.trustedDomains": {
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com": true,
    "https://json.schemastore.org/": true,
    "https://www.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://ui.shadcn.com": true
  },
  "github.copilot.enable": {
    "javascript": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "json": false,
    "*": false
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      { "scope": ["source", "text.html"], "settings": { "fontStyle": "" } }
    ]
  },
  "editor.codeActionsOnSave": {
    "source.sortPackageJson": "always",
    "source.fixAll.eslint": "always"
  },
  "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'zero', 'onum'",
  "[php]": { "editor.defaultFormatter": "junstyle.php-cs-fixer" },
  "php-cs-fixer.executablePath": "./vendor/bin/php-cs-fixer",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "[prisma]": { "editor.defaultFormatter": "Prisma.prisma" },
  "[c]": { "editor.defaultFormatter": "ms-vscode.cpptools" },
  "[lua]": { "editor.defaultFormatter": "yinfei.luahelper" },
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "[sql]": { "editor.defaultFormatter": "mtxr.sqltools" },
  "js/ts.preferences.includePackageJsonAutoImports": "on",
  "js/ts.implicitProjectConfig.strictNullChecks": false,
  "editor.suggest.selectionMode": "whenQuickSuggestion",
  "diffEditor.useInlineViewWhenSpaceIsLimited": false,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "security.workspace.trust.untrustedFiles": "open",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "terminal.integrated.defaultLocation": "editor",
  "postman.mcp.notifications.postmanMCP": false,
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.root": "/sub_modules/",
  "php-cs-fixer.config": "/.php-cs-fixer.php",
  "workbench.colorTheme": "Catppuccin Mocha",
  "scm.repositories.selectionMode": "single",
  "terminal.integrated.mouseWheelZoom": true,
  "workbench.activityBar.location": "hidden",
  "editor.suggestSelection": "recentlyUsed",
  "editor.cursorSmoothCaretAnimation": "on",
  "workbench.layoutControl.enabled": false,
  "workbench.list.openMode": "doubleClick",
  "terminal.integrated.initialHint": false,
  "diffEditor.ignoreTrimWhitespace": true,
  "workbench.editor.enablePreview": false,
  "editor.parameterHints.enabled": false,
  "editor.fontFamily": "'Cascadia Code'",
  "workbench.sideBar.location": "right",
  "window.menuBarVisibility": "compact",
  "editor.autoClosingBrackets": "never",
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "editor.accessibilitySupport": "off",
  "workbench.statusBar.visible": false,
  "css.lint.unknownAtRules": "ignore",
  "diffEditor.renderSideBySide": true,
  "editor.autoClosingQuotes": "never",
  "intelephense.format.enable": false,
  "settingsSync.ignoredSettings": [],
  "postman.telemetry.enabled": false,
  "editor.guides.bracketPairs": true,
  "terminal.integrated.fontSize": 17,
  "prettier.objectWrap": "collapse",
  "workbench.startupEditor": "none",
  "editor.suggest.showWords": false,
  "files.simpleDialog.enable": true,
  "editor.cursorBlinking": "expand",
  "prettier.trailingComma": "none",
  "prettier.bracketSameLine": true,
  "prettier.jsxSingleQuote": true,
  "prettier.arrowParens": "avoid",
  "explorer.confirmDelete": false,
  "php-cs-fixer.allowRisky": true,
  "git.replaceTagsWhenPull": true,
  "editor.smoothScrolling": true,
  "git.enableSmartCommit": true,
  "editor.mouseWheelZoom": true,
  "window.commandCenter": false,
  "window.zoomPerWindow": false,
  "eslint.format.enable": true,
  "editor.linkedEditing": true,
  "prettier.singleQuote": true,
  "js/ts.suggest.paths": false,
  "mdb.confirmRunAll": false,
  "mdb.mcp.server": "prompt",
  "git.confirmSync": false,
  "editor.wordWrap": "on",
  "update.mode": "manual",
  "git.autofetch": true,
  "editor.fontSize": 19,
  "window.zoomLevel": 2,
  "editor.tabSize": 2
}
