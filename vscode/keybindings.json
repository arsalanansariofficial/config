[
  // Workbench
  {
    "command": "workbench.debug.viewlet.action.removeAllBreakpoints",
    "key": "ctrl+alt+h"
  },
  {
    "command": "workbench.files.action.collapseExplorerFolders",
    "key": "ctrl+shift+'"
  },
  { "command": "workbench.action.toggleActivityBarVisibility", "key": "win+`" },
  { "command": "workbench.action.toggleStatusbarVisibility", "key": "alt+`" },
  { "command": "workbench.action.terminal.toggleTerminal", "key": "ctrl+`" },
  { "command": "workbench.action.toggleSidebarVisibility", "key": "alt+1" },
  { "command": "workbench.action.navigateForward", "key": "ctrl+pagedown" },
  { "command": "workbench.actions.view.problems", "key": "ctrl+shift+m" },
  { "command": "workbench.action.navigateBack", "key": "ctrl+pageup" },
  { "command": "workbench.action.previousEditor", "key": "alt+left" },
  { "command": "workbench.action.zoomOut", "key": "ctrl+shift+[" },
  { "command": "workbench.action.nextEditor", "key": "alt+right" },
  { "command": "workbench.action.zoomIn", "key": "ctrl+shift+]" },
  { "command": "workbench.view.extension.sqlxs", "key": "alt+4" },
  { "command": "workbench.action.gotoLine", "key": "ctrl+g" },
  { "command": "workbench.view.scm", "key": "ctrl+shift+g" },
  { "command": "workbench.view.explorer", "key": "alt+2" },

  // Editor
  { "command": "editor.action.moveLinesDownAction", "key": "ctrl+shift+down" },
  { "command": "editor.action.addSelectionToNextFindMatch", "key": "alt+d" },
  { "command": "editor.action.selectHighlights", "key": "ctrl+shift+alt+j" },
  { "command": "editor.action.moveLinesUpAction", "key": "ctrl+shift+up" },
  { "command": "editor.action.copyLinesDownAction", "key": "ctrl+d" },
  { "command": "editor.action.formatDocument", "key": "ctrl+alt+l" },
  { "command": "editor.action.marker.next", "key": "shift+f2" },
  { "command": "editor.action.quickFix", "key": "alt+enter" },
  { "command": "editor.unfoldAll", "key": "ctrl+shift+=" },
  { "command": "editor.foldAll", "key": "ctrl+shift+-" },
  { "command": "editor.unfold", "key": "ctrl+=" },
  { "command": "editor.fold", "key": "ctrl+-" },

  // Explorer
  { "command": "explorer.newFolder", "key": "alt+p" },
  { "command": "explorer.newFile", "key": "alt+s" },

  // Json
  { "command": "json.sort", "key": "shift+alt+f" },

  // Sqlx
  { "command": "sqlxs.refreshConnections", "key": "ctrl+shift+enter" },
  { "command": "sqlxs.runCurrentBlock", "key": "ctrl+enter" },

  // Format By Ignore
  {
    "command": "formatFilesByIgnores.start.formatWorkspace",
    "key": "ctrl+shift+alt+l"
  },

  // Sort Lines
  { "command": "sortLines.sortLinesLineLengthReverse", "key": "ctrl+alt+;" },

  // Postman
  { "command": "postman-for-vscode.sidebar-panel.focus", "key": "alt+3" }
]
